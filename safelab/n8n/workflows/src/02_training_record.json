    {
      "name": "Build training record",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "jsCode": "/*@@SAFELAB_LIB@@*/\n\n// ---- Shared helpers (same block in every SafeLab workflow) ----\nconst rowsOf = (node) => $(node).all().map((i) => i.json).filter((r) => r && Object.keys(r).length);\nconst now = $now.setZone('Asia/Ho_Chi_Minh');\nconst today = now.toFormat('yyyy-MM-dd');\nconst nowIso = now.toFormat(\"yyyy-MM-dd'T'HH:mm:ssZZ\"); // e.g. 2026-10-11T21:30:00+07:00\nconst year = now.year;\nconst esc = SafeLab.escapeHtml;\nconst text = (v) => (v === null || v === undefined ? '' : String(v).trim());\nconst lower = (v) => text(v).toLowerCase();\n// Google Sheets treats text starting with = + - @ as a formula: prefix ' so it is stored as plain text.\nconst sheetRow = (row) => Object.fromEntries(Object.entries(row).map(([k, v]) =>\n  [k, typeof v === 'string' && /^[=+\\-@]/.test(v) ? \"'\" + v : v]));\nconst audit = (actor, action, entity, entityId, details) =>\n  sheetRow({ ts: nowIso, actor: actor || 'system', action, entity, entity_id: entityId, details: text(details).slice(0, 1000) });\nconst link = (url, label) =>\n  (text(url) ? `<a href=\"${esc(url)}\">${esc(label)}</a>` : `${esc(label)} (link not configured in CONFIG)`);\nconst mail = (to, subject, body) => ({\n  to: [...new Set([].concat(to).map(lower).filter(Boolean))].join(', '),\n  subject: text(subject).replace(/\\s+/g, ' '),\n  html: `<div style=\"font-family:Arial,sans-serif;font-size:14px;line-height:1.5;color:#111\">${body}` +\n    '<p style=\"color:#6b7280;font-size:12px;margin-top:24px\">Automated message from SafeLab (lab-safety approval system).</p></div>',\n});\nconst cfg = SafeLab.configMap(rowsOf('Read CONFIG'));\n\n// ---- 02 Training record: F02 row -> TRAINING_RECORDS row, confirmation email ----\nconst types = {};\nrowsOf('Read TRAINING_TYPES').forEach((t) => { if (text(t.training_code)) types[text(t.training_code).toUpperCase()] = t; });\nconst ids = rowsOf('Read TRAINING_RECORDS').map((r) => r.record_id);\n\nconst records = [];\nconst auditRows = [];\nconst emails = [];\n\nfor (const r of rowsOf('F02 row added')) {\n  const email = lower(r['Email Address']);\n  if (!email) continue;\n  // Dropdown value is \"<training_code> — <name>\"\n  const code = text(r['Training']).split(/\\s+[—–-]\\s+/)[0].trim().toUpperCase();\n  const type = types[code];\n  const completedOn = SafeLab.parseDate(r['Completion date']);\n  const expiresOn = type ? SafeLab.trainingExpiry(completedOn, type.validity_months) : '';\n  const id = SafeLab.nextId('TR', year, ids);\n  ids.push(id);\n\n  records.push(sheetRow({\n    record_id: id,\n    email,\n    training_code: code,\n    completed_on: completedOn,\n    expires_on: expiresOn,\n    quiz_score: text(r['Quiz score (%)']),\n    evidence_url: text(r['Evidence link']),\n    recorded_at: nowIso,\n  }));\n  auditRows.push(audit(email, 'TRAINING_RECORDED', 'TRAINING_RECORDS', id,\n    `${code} completed ${completedOn || '?'}, expires ${expiresOn || 'never'}`));\n\n  const problems = [];\n  if (!type) problems.push(`Training code \"${code}\" is not in TRAINING_TYPES – the safety coordinator will check it.`);\n  if (!completedOn) problems.push('The completion date could not be read.');\n  emails.push(mail(email, `[SafeLab] Training recorded – ${code} (${id})`,\n    `<h2>Training recorded: ${esc(code)}${type ? ' – ' + esc(type.name) : ''}</h2>` +\n    `<p>Record ID: <b>${esc(id)}</b><br>Completed on: <b>${esc(completedOn || '?')}</b><br>` +\n    `Valid until: <b>${esc(expiresOn || (type ? 'does not expire' : 'unknown'))}</b></p>` +\n    (problems.length ? `<p style=\"color:#b45309\"><b>Please check:</b><br>${problems.map(esc).join('<br>')}</p>` : '') +\n    '<p>You will get a reminder before this training expires.</p>'));\n}\n\nreturn [{ json: { records, audit: auditRows, emails: emails.filter((e) => e.to) } }];\n"
      },
      "id": "f1f9d175-b6eb-4e11-a74e-9b3f2e6f1599"
