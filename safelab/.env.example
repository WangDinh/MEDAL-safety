# Copy to .env and fill in. Never commit .env.

# Long random string. Keep it stable and backed up: it decrypts stored n8n credentials.
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string

# Long random string used to sign approval links in emails.
SAFELAB_SECRET=change-me-to-another-long-random-string

# Base URL people's browsers use to reach n8n (approval links).
# Local demo: http://localhost:5678  ·  Real deploy: https://safelab.your-domain
SAFELAB_PUBLIC_URL=http://localhost:5678

# Pin an n8n version for reproducible deploys (e.g. 1.x.y); "latest" for a quick test.
N8N_VERSION=latest
