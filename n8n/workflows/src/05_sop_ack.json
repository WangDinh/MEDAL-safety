    {
      "name": "Build SOP acknowledgement",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "jsCode": "/*@@SAFELAB_LIB@@*/\n\n// ---- Shared helpers (same block in every SafeLab workflow) ----\nconst rowsOf = (node) => $(node).all().map((i) => i.json).filter((r) => r && Object.keys(r).length);\nconst now = $now.setZone('Asia/Ho_Chi_Minh');\nconst today = now.toFormat('yyyy-MM-dd');\nconst nowIso = now.toFormat(\"yyyy-MM-dd'T'HH:mm:ssZZ\"); // e.g. 2026-10-11T21:30:00+07:00\nconst year = now.year;\nconst esc = SafeLab.escapeHtml;\nconst text = (v) => (v === null || v === undefined ? '' : String(v).trim());\nconst lower = (v) => text(v).toLowerCase();\n// Google Sheets treats text starting with = + - @ as a formula: prefix ' so it is stored as plain text.\nconst sheetRow = (row) => Object.fromEntries(Object.entries(row).map(([k, v]) =>\n  [k, typeof v === 'string' && /^[=+\\-@]/.test(v) ? \"'\" + v : v]));\nconst audit = (actor, action, entity, entityId, details) =>\n  sheetRow({ ts: nowIso, actor: actor || 'system', action, entity, entity_id: entityId, details: text(details).slice(0, 1000) });\nconst link = (url, label) =>\n  (text(url) ? `<a href=\"${esc(url)}\">${esc(label)}</a>` : `${esc(label)} (link not configured in CONFIG)`);\nconst mail = (to, subject, body) => ({\n  to: [...new Set([].concat(to).map(lower).filter(Boolean))].join(', '),\n  subject: text(subject).replace(/\\s+/g, ' '),\n  html: `<div style=\"font-family:Arial,sans-serif;font-size:14px;line-height:1.5;color:#111\">${body}` +\n    '<p style=\"color:#6b7280;font-size:12px;margin-top:24px\">Automated message from SafeLab (lab-safety approval system).</p></div>',\n});\nconst cfg = SafeLab.configMap(rowsOf('Read CONFIG'));\n\n// ---- 05 SOP acknowledgement: F03 row -> SOP_ACK row for the CURRENT SOP version ----\nconst sops = {};\nrowsOf('Read SOP_MASTER').forEach((s) => { if (text(s.sop_id)) sops[text(s.sop_id).toUpperCase()] = s; });\nconst ids = rowsOf('Read SOP_ACK').map((r) => r.ack_id);\n\nconst acks = [];\nconst auditRows = [];\nconst emails = [];\n\nfor (const r of rowsOf('F03 row added')) {\n  const email = lower(r['Email Address']);\n  if (!email) continue;\n  // Dropdown value is \"<sop_id> — <title>\"\n  const sopId = text(r['SOP']).split(/\\s+[—–-]\\s+/)[0].trim().toUpperCase();\n  const sop = sops[sopId];\n  const problem = !sop ? `${sopId || '(blank)'} is not in SOP_MASTER`\n    : text(sop.status).toUpperCase() !== 'ACTIVE' ? `${sopId} is not ACTIVE (${text(sop.status) || 'blank'})`\n    : !text(r['Acknowledgement']) ? 'the acknowledgement box was not ticked' : '';\n\n  if (problem) {\n    auditRows.push(audit(email, 'SOP_ACK_REJECTED', 'SOP_ACK', sopId, problem));\n    emails.push(mail(email, `[SafeLab] SOP acknowledgement not recorded – ${sopId}`,\n      `<h2>SOP acknowledgement not recorded</h2><p>Your acknowledgement of <b>${esc(sopId)}</b> could not be recorded: ` +\n      `${esc(problem)}.</p><p>Please contact the safety coordinator or submit the ` +\n      `${link(cfg.FORM_F03_URL, 'SOP Acknowledgement form (F03)')} again.</p>`));\n    continue;\n  }\n\n  const id = SafeLab.nextId('ACK', year, ids);\n  ids.push(id);\n  acks.push(sheetRow({ ack_id: id, email, sop_id: sopId, version: sop.version, acknowledged_at: nowIso }));\n  auditRows.push(audit(email, 'SOP_ACKNOWLEDGED', 'SOP_ACK', id, `${sopId} v${text(sop.version)}`));\n}\n\nreturn [{ json: { acks, audit: auditRows, emails: emails.filter((e) => e.to) } }];\n"
      },
      "id": "e566cfd2-2072-4f4e-a902-4048d0e8045a"
